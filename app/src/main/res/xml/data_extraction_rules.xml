<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone: the paired Macs pin this phone's own key (in Keystore, which never
     moves), so a backup or a transfer to a new phone could restore nothing useful. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
